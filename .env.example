# Environment variables

# ==============================================================================
# CONFIGURAÇÃO DO GATEWAY DE PAGAMENTO (ASAAS, STRIPE, MERCADO PAGO, ETC.)
# ==============================================================================
# Provedor ativo de pagamento ("sandbox" | "asaas" | "stripe" | "mercadopago")
# Padrão: sandbox (permite testar fluxos completos de cartão, PIX e perfis sem custos)
PAYMENT_GATEWAY_PROVIDER=sandbox

# Chave de API Secreta do Gateway
# - Stripe: sk_live_... ou sk_test_...
# - Asaas: $aact_YTU5YTE0M2M6...
# - Mercado Pago: APP_USR-...
PAYMENT_GATEWAY_API_KEY=

# Chave Pública / Token de Frontend (para tokenização segura de cartões sem PCI)
# - Stripe: pk_live_... ou pk_test_...
# - Mercado Pago: APP_USR-...
VITE_PAYMENT_GATEWAY_PUBLIC_KEY=

# Segredo de Verificação de Assinatura do Webhook (HMAC / Webhook Secret)
# Usado para validar que as notificações recebidas em /api/subscriptions/webhook
# realmente foram enviadas pelo seu gateway de pagamento.
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# URL Base pública da aplicação (para retorno de checkout e callbacks de PIX/Boleto)
APP_BASE_URL=http://localhost:3000
